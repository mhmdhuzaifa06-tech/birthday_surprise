
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday Khola ✨</title>

  <style>
    :root {
      --gold: #f5d477;
      --gold-light: #fff0b5;
      --black: #080808;
      --card: #15130f;
      --white: #fffaf0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      background:
        radial-gradient(ellipse at top, #302410 0%, #100e0a 38%, #050505 78%);
      color: var(--white);
      font-family: Georgia, "Times New Roman", serif;
    }

    button {
      font-family: inherit;
    }

    .hidden {
      display: none !important;
    }

    .screen {
      min-height: 100vh;
      padding: 35px 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      isolation: isolate;
    }

    .stars {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: -1;
      background-image:
        radial-gradient(2px 2px at 15% 20%, #ffe7a3 50%, transparent 100%),
        radial-gradient(2px 2px at 75% 30%, #fff2c2 50%, transparent 100%),
        radial-gradient(1px 1px at 45% 65%, #ffffff 50%, transparent 100%),
        radial-gradient(2px 2px at 85% 80%, #f5d477 50%, transparent 100%),
        radial-gradient(1px 1px at 25% 85%, #ffffff 50%, transparent 100%);
      opacity: 0.7;
    }

    .card {
      width: min(100%, 650px);
      padding: 42px 28px;
      text-align: center;
      background: rgba(20, 18, 13, 0.91);
      border: 1px solid rgba(245, 212, 119, 0.55);
      border-radius: 26px;
      box-shadow:
        0 0 35px rgba(245, 212, 119, 0.09),
        inset 0 0 25px rgba(245, 212, 119, 0.025);
      animation: appear 1s ease both;
    }

    .eyebrow {
      color: var(--gold);
      letter-spacing: 5px;
      font-size: 12px;
      text-transform: uppercase;
      margin-bottom: 22px;
    }

    h1 {
      font-size: clamp(42px, 9vw, 76px);
      line-height: 1.08;
      color: var(--gold-light);
      text-shadow: 0 0 25px rgba(245, 212, 119, 0.25);
      margin-bottom: 18px;
    }

    h2 {
      color: var(--gold-light);
      font-size: clamp(27px, 6vw, 42px);
      margin-bottom: 18px;
    }

    p {
      color: #e7dfce;
      line-height: 1.8;
      font-size: 17px;
    }

    .gold {
      color: var(--gold);
    }

    .sparkle {
      font-size: 38px;
      margin-bottom: 18px;
      animation: twinkle 2s infinite ease-in-out;
    }

    .button {
      border: 1px solid var(--gold);
      background: linear-gradient(135deg, #fff0b5, #d9ad43);
      color: #171108;
      font-weight: bold;
      font-size: 16px;
      padding: 14px 28px;
      border-radius: 999px;
      cursor: pointer;
      margin-top: 28px;
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .button:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 24px rgba(245, 212, 119, 0.3);
    }

    .button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .small-note {
      font-size: 13px;
      color: #a9a08c;
      margin-top: 18px;
    }

    /* Secret question */

    .question {
      font-size: 20px;
      color: var(--gold-light);
      margin: 20px 0 24px;
    }

    .options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      text-align: left;
    }

    .option {
      position: relative;
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 58px;
      padding: 14px;
      border: 1px solid #554729;
      border-radius: 14px;
      cursor: pointer;
      background: #19170f;
      transition: 0.2s ease;
    }

    .option:hover {
      border-color: var(--gold);
      background: #252013;
    }

    .option:has(input:checked) {
      border-color: var(--gold);
      background: #302719;
      box-shadow: 0 0 15px rgba(245, 212, 119, 0.12);
    }

    .option input {
      accent-color: #e8c15c;
      width: 17px;
      height: 17px;
      flex-shrink: 0;
    }

    .option span {
      color: #fff4d6;
      font-size: 16px;
    }

    .feedback {
      min-height: 28px;
      margin-top: 16px;
      color: var(--gold);
      font-size: 15px;
    }

    /* Birthday cake */

    .cake-area {
      padding: 24px 0 10px;
      cursor: pointer;
      user-select: none;
    }

    .cake {
      position: relative;
      width: 190px;
      height: 175px;
      margin: 0 auto;
    }

    .cake-plate {
      position: absolute;
      bottom: 12px;
      left: 0;
      width: 190px;
      height: 14px;
      border-radius: 50%;
      background: linear-gradient(#fff1bd, #b48a2e);
      box-shadow: 0 0 25px rgba(245, 212, 119, 0.16);
    }

    .cake-bottom {
      position: absolute;
      bottom: 25px;
      left: 15px;
      width: 160px;
      height: 57px;
      background: linear-gradient(90deg, #815018, #e7bd5b, #815018);
      border-radius: 8px 8px 13px 13px;
    }

    .cake-middle {
      position: absolute;
      bottom: 80px;
      left: 25px;
      width: 140px;
      height: 40px;
      background: linear-gradient(90deg, #b9822d, #ffe7a0, #b9822d);
      border-radius: 8px 8px 4px 4px;
    }

    .icing {
      position: absolute;
      bottom: 105px;
      left: 25px;
      width: 140px;
      height: 20px;
      border-radius: 10px 10px 5px 5px;
      background: #fff0b5;
    }

    .icing::before,
    .icing::after {
      content: "";
      position: absolute;
      top: 9px;
      width: 12px;
      background: #fff0b5;
      border-radius: 0 0 8px 8px;
    }

    .icing::before {
      left: 30px;
      height: 17px;
    }

    .icing::after {
      right: 32px;
      height: 12px;
    }

    .candle {
      position: absolute;
      z-index: 2;
      bottom: 124px;
      left: 89px;
      width: 12px;
      height: 37px;
      border-radius: 3px;
      background: repeating-linear-gradient(
        135deg,
        #fff8dc 0 7px,
        #d7a93f 7px 13px
      );
    }

    .flame {
      position: absolute;
      bottom: 160px;
      left: 88px;
      width: 15px;
      height: 23px;
      border-radius: 50% 50% 45% 45%;
      background: radial-gradient(circle at 50% 65%, #fffbd4 0 15%, #ffcc45 45%, #ff762b 75%);
      box-shadow: 0 0 20px #ffca55, 0 0 45px rgba(255, 174, 42, 0.55);
      transform-origin: bottom;
      animation: flicker 0.8s infinite alternate;
    }

    .flame.off {
      display: none;
    }

    .cake-instruction {
      font-size: 14px;
      color: #bcb29c;
      margin-top: 10px;
    }

    .letter {
      text-align: left;
      white-space: pre-line;
      line-height: 2;
      padding: 24px;
      margin-top: 24px;
      border-radius: 16px;
      border: 1px solid #594a2c;
      background: rgba(255, 255, 255, 0.025);
      color: #f5ebd4;
      font-size: 17px;
    }

    .signature {
      margin-top: 22px;
      text-align: right;
      color: var(--gold);
      font-style: italic;
      font-size: 19px;
    }

    /* Floating animations */

    .floating {
      position: fixed;
      bottom: -40px;
      z-index: 10;
      pointer-events: none;
      animation: floatUp 5s linear forwards;
    }

    .confetti {
      position: fixed;
      top: -15px;
      z-index: 100;
      pointer-events: none;
      animation: fall linear forwards;
    }

    @keyframes appear {
      from { opacity: 0; transform: translateY(20px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes twinkle {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.12); opacity: 1; }
    }

    @keyframes flicker {
      from { transform: rotate(-4deg) scale(1); }
      to { transform: rotate(4deg) scale(1.08); }
    }

    @keyframes floatUp {
      0% { transform: translateY(0) rotate(0); opacity: 0; }
      10% { opacity: 1; }
      100% { transform: translateY(-110vh) rotate(35deg); opacity: 0; }
    }

    @keyframes fall {
      to { transform: translateY(110vh) rotate(720deg); opacity: 0.8; }
    }

    @media (max-width: 450px) {
      .card {
        padding: 35px 18px;
      }

      .options {
        grid-template-columns: 1fr;
      }

      .letter {
        padding: 18px;
        font-size: 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>
  <div class="stars"></div>

  <!-- Screen 1: Welcome -->
  <section class="screen" id="welcome">
    <div class="card">
      <div class="sparkle">✦ ✧ ✦</div>
      <div class="eyebrow">A special day for someone special</div>

      <h1>Happy Birthday<br><span class="gold">Khola</span></h1>

      <p>
        Today is all about you, Princess. 💛<br>
        A little surprise has been prepared just for you.
      </p>

      <button class="button" id="startBtn">
        Open Your Surprise ✨
      </button>

      <div class="small-note">Made with love, just for you.</div>
    </div>
  </section>

  <!-- Screen 2: Secret question -->
  <section class="screen hidden" id="quiz">
    <div class="card">
      <div class="sparkle">🔐</div>
      <div class="eyebrow">Before you enter</div>

      <h2>One Little Question</h2>

      <p>Let's see which brother Princess chooses! 💛</p>

      <div class="question">
        Who is your favourite among your brothers?
      </div>

      <div class="options" id="options"></div>

      <div class="feedback" id="quizFeedback" aria-live="polite"></div>

      <button class="button" id="unlockBtn">
        Unlock My Surprise 💛
      </button>
    </div>
  </section>

  <!-- Screen 3: Birthday cake -->
  <section class="screen hidden" id="surprise">
    <div class="card">
      <div class="eyebrow">Your magical birthday moment</div>

      <h2>Make a Wish, Princess! ✨</h2>

      <p>
        Close your eyes, make a beautiful wish,<br>
        and tap the cake to blow out your candle.
      </p>

      <div class="cake-area" id="cakeArea" role="button"
           tabindex="0" aria-label="Tap the cake to blow out the candle">
        <div class="cake">
          <div class="cake-plate"></div>
          <div class="cake-bottom"></div>
          <div class="cake-middle"></div>
          <div class="icing"></div>
          <div class="candle"></div>
          <div class="flame" id="flame"></div>
        </div>
      </div>

      <div class="cake-instruction" id="cakeInstruction">
        Tap the cake to make your wish come true 🕯️
      </div>

      <button class="button hidden" id="letterBtn">
        Read Your Birthday Letter 💌
      </button>
    </div>
  </section>

  <!-- Screen 4: Birthday letter -->
  <section class="screen hidden" id="letterScreen">
    <div class="card">
      <div class="sparkle">💌</div>
      <div class="eyebrow">A letter from the heart</div>

      <h2>Dear Princess Khola,</h2>

      <div class="letter">Happy Birthday to the most wonderful sister! 💛

May your life always be filled with happiness, peace, success, and endless blessings.

May every new day bring you a reason to smile, every dream bring you closer to your goals, and every challenge make you stronger.

Never forget how special you are. Your smile makes ordinary moments brighter, and your presence makes our family more beautiful.

I pray that Allah blesses you with good health, a long and beautiful life, success in everything you do, and happiness that never fades.

Keep smiling, keep shining, and always remember that you deserve the very best in life.

Today is your day, Princess. Enjoy every moment, make beautiful memories, and never stop believing in yourself. ✨

Happy Birthday once again! 🎂</div>

      <div class="signature">With lots of love, your brother ❤️</div>

      <button class="button" id="celebrateBtn">
        Let’s Celebrate! 🎉
      </button>
    </div>
  </section>

  <!-- Screen 5: Final celebration -->
  <section class="screen hidden" id="finalScreen">
    <div class="card">
      <div class="sparkle">🎉 ✨ 🎂 ✨ 🎉</div>

      <div class="eyebrow">Today and always</div>

      <h1>Shine On,<br><span class="gold">Princess!</span></h1>

      <p>
        May your birthday be as beautiful as your heart<br>
        and your future brighter than a thousand stars.
      </p>

      <h2 style="margin-top: 25px;">Happy Birthday, Khola! 💛</h2>

      <p class="gold">You are loved more than words can say.</p>

      <button class="button" id="againBtn">
        Celebrate Again ✨
      </button>
    </div>
  </section>

  <script>
    // Brother names: only ONE option can be selected.
    const BROTHER_NAMES = [
      "Hamza",
      "Shoaib",
      "Huzaifa",
      "Hassaan",
      "Ali"
    ];

    const $ = (id) => document.getElementById(id);

    const screens = [
      $("welcome"),
      $("quiz"),
      $("surprise"),
      $("letterScreen"),
      $("finalScreen")
    ];

    function showScreen(screenToShow) {
      screens.forEach((screen) => screen.classList.add("hidden"));
      screenToShow.classList.remove("hidden");

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    }

    // Create the single-select brother options.
    function buildOptions() {
      const container = $("options");
      container.innerHTML = "";

      BROTHER_NAMES.forEach((name, index) => {
        const label = document.createElement("label");
        label.className = "option";

        const input = document.createElement("input");
        input.type = "radio";
        input.name = "brothers";
        input.value = name;
        input.id = "brother-" + index;
        input.required = true;

        const text = document.createElement("span");
        text.textContent = name;

        label.appendChild(input);
        label.appendChild(text);
        container.appendChild(label);
      });
    }

    buildOptions();

    // Welcome screen.
    $("startBtn").addEventListener("click", () => {
      showScreen($("quiz"));
      burstHearts(8);
    });

    // Select one brother and unlock the surprise.
    // Any of the five choices unlocks the website.
    $("unlockBtn").addEventListener("click", () => {
      const selected = document.querySelector(
        'input[name="brothers"]:checked'
      );

      if (!selected) {
        $("quizFeedback").textContent =
          "Please select one brother's name, Princess! 💛";
        return;
      }

      $("quizFeedback").textContent =
        `You selected ${selected.value}! Your surprise is ready! 💛`;

      $("unlockBtn").disabled = true;

      setTimeout(() => {
        showScreen($("surprise"));
        launchConfetti(70);
        burstHearts(18);
        $("unlockBtn").disabled = false;
      }, 800);
    });

    // Interactive birthday cake.
    let candleBlownOut = false;

    function blowOutCandle() {
      if (candleBlownOut) return;

      candleBlownOut = true;
      $("flame").classList.add("off");

      $("cakeInstruction").textContent =
        "Your wish has been sent to the stars! ✨💛";

      $("letterBtn").classList.remove("hidden");

      launchConfetti(100);
      burstHearts(22);
    }

    $("cakeArea").addEventListener("click", blowOutCandle);

    $("cakeArea").addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        blowOutCandle();
      }
    });

    // Birthday letter.
    $("letterBtn").addEventListener("click", () => {
      showScreen($("letterScreen"));
      burstHearts(12);
    });

    // Final celebration.
    $("celebrateBtn").addEventListener("click", () => {
      showScreen($("finalScreen"));
      launchConfetti(180);
      burstHearts(35);
    });

    // Celebrate again.
    $("againBtn").addEventListener("click", () => {
      launchConfetti(180);
      burstHearts(35);
    });

    // Floating hearts.
    function burstHearts(amount = 15) {
      const hearts = ["💛", "💖", "💕", "✨", "💗"];

      for (let i = 0; i < amount; i++) {
        const heart = document.createElement("div");
        heart.className = "floating";
        heart.textContent =
          hearts[Math.floor(Math.random() * hearts.length)];

        heart.style.left = Math.random() * 100 + "vw";
        heart.style.fontSize = (16 + Math.random() * 22) + "px";
        heart.style.animationDuration = (3 + Math.random() * 3) + "s";

        document.body.appendChild(heart);

        setTimeout(() => heart.remove(), 6500);
      }
    }

    // Gold, white and champagne confetti.
    function launchConfetti(amount = 100) {
      const colors = [
        "#f5d477",
        "#fff0b5",
        "#ffffff",
        "#d6a83f",
        "#e9b6c8"
      ];

      for (let i = 0; i < amount; i++) {
        const piece = document.createElement("div");
        piece.className = "confetti";

        piece.style.left = Math.random() * 100 + "vw";
        piece.style.width = (5 + Math.random() * 8) + "px";
        piece.style.height = (8 + Math.random() * 12) + "px";
        piece.style.background =
          colors[Math.floor(Math.random() * colors.length)];
        piece.style.borderRadius = Math.random() > 0.5 ? "50%" : "2px";
        piece.style.animationDuration = (2 + Math.random() * 3) + "s";
        piece.style.animationDelay = (Math.random() * 0.8) + "s";

        document.body.appendChild(piece);

        setTimeout(() => piece.remove(), 6500);
      }
    }
  </script>
</body>
</html>
